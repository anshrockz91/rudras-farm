{
  "firestore": {
    "rules": "firestore.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Snoozeville",
        "supportEmail": "ansh.rockz91@gmail.com",
        "authorizedRedirectUris": [
          "https://rudras-farm-game.web.app/__/auth/handler",
          "https://rudras-farm-game.firebaseapp.com/__/auth/handler",
          "https://snoozeville.web.app/__/auth/handler"
        ]
      }
    }
  },
  "hosting": [
    {
      "target": "main",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        ".firebaserc",
        ".git/**",
        ".nojekyll",
        "**/.*",
        "**/node_modules/**",
        "tools/**"
      ],
      "headers": [
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "snooze",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        ".firebaserc",
        ".git/**",
        ".nojekyll",
        "**/.*",
        "**/node_modules/**",
        "tools/**"
      ],
      "headers": [
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}